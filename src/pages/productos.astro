---
import Layout from '../layouts/Layout.astro';
import { productosAPI, categoriasAPI } from '../lib/api';

const roleCookie = Astro.cookies.get('role')?.value ?? 'USER';
const esAdmin = roleCookie === 'ADMIN';

const [productos, categorias] = await Promise.all([
    productosAPI.obtenerTodos(),
    categoriasAPI.obtenerTodas(),
]);

const productosJSON = JSON.stringify(productos);
const categoriasJSON = JSON.stringify(categorias);
---

<Layout title="Productos" activePage="productos">
    {esAdmin && (
            <button class="btn btn-primary" id="btn-nuevo" slot="actions">
                + Nuevo producto
            </button>
    )}

    <div id="alert-container" class="alert" style="display:none;"></div>

    <div class="table-wrapper">
        <table>
            <thead>
            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Categoría</th>
                <th>Precio</th>
                <th>Stock</th>
                {esAdmin && <th>Acciones</th>}
            </tr>
            </thead>
            <tbody>
            {productos.map(p => (
                    <tr>
                        <td><span class="id-badge">#{p.id}</span></td>
                        <td>
                            <strong>{p.nombre}</strong>
                            {p.descripcion && <p class="desc">{p.descripcion}</p>}
                        </td>
                        <td>{p.categoria?.nombre ?? <span class="muted">Sin categoría</span>}</td>
                        <td class="mono">
                            {new Intl.NumberFormat('es-CO', {
                                style: 'currency',
                                currency: 'COP',
                                minimumFractionDigits: 0
                            }).format(p.precio)}
                        </td>
                        <td>
                            <span class={p.stock < 5 ? 'stock-low' : 'stock-ok'}>
                                {p.stock}
                            </span>
                        </td>
                        {esAdmin && (
                                <td>
                                    <div class="actions-cell">
                                        <button class="btn btn-edit btn-sm" data-id={p.id} data-action="edit">
                                            Editar
                                        </button>
                                        <button class="btn btn-danger btn-sm" data-id={p.id} data-action="delete">
                                            Eliminar
                                        </button>
                                        <button
                                                class="btn btn-sm btn-historial"
                                                data-id={p.id}
                                                data-action="historial"
                                                data-nombre={p.nombre}
                                        >
                                            Historial
                                        </button>
                                    </div>
                                </td>
                        )}
                    </tr>
            ))}
            </tbody>
        </table>
    </div>
</Layout>

{esAdmin && (
    <!-- MODAL PRINCIPAL PRODUCTOS -->
<div id="modal" class="modal-overlay" style="display:none;">
    <div class="modal-box">
        <div class="modal-header">
            <h2 id="modal-title" class="modal-title">Nuevo Producto</h2>
            <button id="modal-close" class="modal-close" type="button">✕</button>
        </div>
        <form id="producto-form" class="form">
            <input type="hidden" id="producto-id" />
            <div class="form-group">
                <label for="nombre">Nombre *</label>
                <input type="text" id="nombre" required />
            </div>
            <div class="form-group">
                <label for="descripcion">Descripción</label>
                <textarea id="descripcion" rows="2"></textarea>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label for="precio">Precio *</label>
                    <input type="number" id="precio" step="0.01" min="0" required />
                </div>
                <div class="form-group">
                    <label for="stock">Stock *</label>
                    <input type="number" id="stock" min="0" required />
                </div>
            </div>
            <div class="form-group">
                <label for="categoria-select">Categoría</label>
                <select id="categoria-select">
                    <option value="">Sin categoría</option>
                    {categorias.map(c => (
                            <option value={c.id}>{c.nombre}</option>
                    ))}
                </select>
            </div>
            <div class="form-actions">
                <button type="button" id="btn-cancelar" class="btn">Cancelar</button>
                <button type="submit" class="btn btn-primary">Guardar</button>
            </div>
        </form>
    </div>
</div>

    <!-- MODAL HISTORIAL (Separado del principal para evitar conflictos de z-index) -->
<div id="modal-historial" class="modal-overlay" style="display:none;">
    <div class="modal-box" style="max-width:600px;">
        <div class="modal-header">
            <h2 id="historial-title" class="modal-title">Historial</h2>
            <button id="historial-close" class="modal-close">✕</button>
        </div>
        <div id="historial-content" style="max-height:450px; overflow-y:auto; border-top: 1px solid var(--border)">
            <!-- Contenido dinámico -->
        </div>
    </div>
</div>
    )}

<script is:inline define:vars={{ productosJSON, categoriasJSON, esAdmin }}>
    if (esAdmin) {
        const apiUrl = 'http://localhost:8080';
        const productos = JSON.parse(productosJSON);
        const token = localStorage.getItem('token') || '';

        const modal = document.getElementById('modal');
        const modalHistorial = document.getElementById('modal-historial');
        const form = document.getElementById('producto-form');

        // Cerrar Historial
        document.getElementById('historial-close')?.addEventListener('click', () => {
            modalHistorial.style.display = 'none';
        });

        const abrirModal = () => { if (modal) modal.style.display = 'flex'; };
        const cerrarModal = () => {
            if (modal) modal.style.display = 'none';
            form?.reset();
            document.getElementById('producto-id').value = '';
        };

        document.getElementById('btn-nuevo')?.addEventListener('click', () => {
            document.getElementById('modal-title').textContent = 'Nuevo Producto';
            cerrarModal();
            abrirModal();
        });

        document.getElementById('btn-cancelar')?.addEventListener('click', cerrarModal);
        document.getElementById('modal-close')?.addEventListener('click', cerrarModal);

        // Delegación de eventos para la tabla
        document.addEventListener('click', async (e) => {
            const btn = e.target.closest('[data-action]');
            if (!btn) return;

            const id = btn.dataset.id;
            const action = btn.dataset.action;

            if (action === 'edit') {
                const p = productos.find(x => x.id == id);
                if (!p) return;
                document.getElementById('modal-title').textContent = 'Editar Producto';
                document.getElementById('producto-id').value = p.id;
                document.getElementById('nombre').value = p.nombre;
                document.getElementById('descripcion').value = p.descripcion || '';
                document.getElementById('precio').value = p.precio;
                document.getElementById('stock').value = p.stock;
                document.getElementById('categoria-select').value = p.categoria?.id || '';
                abrirModal();
            }

            else if (action === 'delete') {
                if (confirm('¿Eliminar este producto?')) eliminarProducto(id);
            }

            // INTEGRACIÓN DEL HISTORIAL
            else if (action === 'historial') {
                const nombre = btn.dataset.nombre;
                const titleElem = document.getElementById('historial-title');
                const contentElem = document.getElementById('historial-content');

                titleElem.textContent = `Historial — ${nombre}`;
                contentElem.innerHTML = '<p style="padding:24px; color:var(--text-muted); text-align:center">Cargando movimientos...</p>';
                modalHistorial.style.display = 'flex';

                try {
                    const resp = await fetch(`${apiUrl}/movimientos/producto/${id}`, {
                        headers: { 'Authorization': `Bearer ${token}` }
                    });
                    const movimientos = await resp.json();

                    if (!movimientos || movimientos.length === 0) {
                        contentElem.innerHTML = '<p style="padding:24px; color:var(--text-muted); text-align:center">Sin movimientos registrados.</p>';
                        return;
                    }

                    const filas = movimientos.map(m => {
                        const fecha = new Date(m.fecha).toLocaleString('es-CO');
                        const tipo = m.tipo === 'ENTRADA' ? '▲' : '▼';
                        const color = m.tipo === 'ENTRADA' ? 'var(--success)' : 'var(--primary)';
                        const usuario = m.usuario?.username ?? 'sistema';
                        return `
                            <tr style="border-bottom:1px solid #eee">
                                <td style="padding:12px 16px; font-size:13px; color:var(--text-muted)">${fecha}</td>
                                <td style="padding:12px 16px; font-weight:600; color:${color}">${tipo} ${m.cantidad}</td>
                                <td style="padding:12px 16px; font-size:13px">${m.stockAnterior} → ${m.stockNuevo}</td>
                                <td style="padding:12px 16px; font-size:12px; color:var(--text-muted)">${usuario}</td>
                            </tr>`;
                    }).join('');

                    contentElem.innerHTML = `
                        <table style="width:100%; border-collapse:collapse">
                            <thead style="background:#f9f9f9; position:sticky; top:0">
                                <tr>
                                    <th style="padding:10px 16px; text-align:left; font-size:11px; color:#888; font-family:var(--font-mono)">FECHA</th>
                                    <th style="padding:10px 16px; text-align:left; font-size:11px; color:#888; font-family:var(--font-mono)">CAMBIO</th>
                                    <th style="padding:10px 16px; text-align:left; font-size:11px; color:#888; font-family:var(--font-mono)">STOCK</th>
                                    <th style="padding:10px 16px; text-align:left; font-size:11px; color:#888; font-family:var(--font-mono)">USUARIO</th>
                                </tr>
                            </thead>
                            <tbody>${filas}</tbody>
                        </table>`;
                } catch (err) {
                    contentElem.innerHTML = '<p style="padding:24px; color:var(--primary)">Error al cargar el historial.</p>';
                }
            }
        });

        const eliminarProducto = async (id) => {
            try {
                const res = await fetch(`${apiUrl}/productos/${id}`, {
                    method: 'DELETE',
                    headers: { 'Authorization': `Bearer ${token}` }
                });
                if (res.ok) window.location.reload();
            } catch (err) {
                alert('Error al eliminar');
            }
        };

        form?.addEventListener('submit', async (e) => {
            e.preventDefault();
            const id = document.getElementById('producto-id').value;
            const catId = document.getElementById('categoria-select').value;
            const data = {
                nombre: document.getElementById('nombre').value,
                descripcion: document.getElementById('descripcion').value,
                precio: parseFloat(document.getElementById('precio').value),
                stock: parseInt(document.getElementById('stock').value),
                categoria: catId ? { id: parseInt(catId) } : null
            };

            try {
                const url = id ? `${apiUrl}/productos/${id}` : `${apiUrl}/productos`;
                const res = await fetch(url, {
                    method: id ? 'PUT' : 'POST',
                    headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
                    body: JSON.stringify(data)
                });
                if (res.ok) window.location.reload();
            } catch (err) {
                alert('Error al guardar');
            }
        });
    }
</script>

<style>
    /* ... Tus estilos anteriores ... */
    .btn-historial {background:transparent;border:1px solid var(--border);color:var(--text-muted);
    }
    .btn-historial:hover {
        background: #f5f5f5;
        border-color: #ccc;
    }
    /* Estilos base para que se vea igual que el código anterior */
    .id-badge { font-family: var(--font-mono), monospace; font-size: 12px; color: var(--text-muted); }
    .desc { font-size: 12px; color: var(--text-muted); margin-top: 2px; }
    .mono { font-family: var(--font-mono), monospace; font-size: 13px; }
    .muted { color: var(--text-muted); }
    .modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 200; }
    .modal-box { background: white; border-radius: var(--radius); width: 90%; max-width: 480px; padding: 28px; }
    .modal-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; }
    .modal-title { font-family: var(--font-mono), monospace; font-size: 16px; font-weight: 700; }
    .form { display: flex; flex-direction: column; gap: 16px; }
    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    .form-group { display: flex; flex-direction: column; gap: 6px; }
    label { font-size: 13px; font-weight: 500; color: var(--text-muted); }
    input, select, textarea { padding: 9px 12px; border: 1px solid var(--border); border-radius: var(--radius); font-size: 14px; }
    .form-actions { display: flex; justify-content: flex-end; gap: 10px; margin-top: 8px; }
</style>