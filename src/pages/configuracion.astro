---
import Layout from '../layouts/Layout.astro';

const roleCookie = Astro.cookies.get('role')?.value ?? 'USER';
if (roleCookie !== 'ADMIN') {
    return Astro.redirect('/');
}

const API_URL = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:8080';
const tokenCookie = Astro.cookies.get('token')?.value ?? '';

let usuarios: { id: number; username: string; role: string; enabled: boolean; permissions: string[] }[] = [];
let permisosDisponibles: string[] = [];

try {
    const [usersResp, permsResp] = await Promise.all([
        fetch(`${API_URL}/auth/users`, {
            headers: { Authorization: `Bearer ${tokenCookie}` }
        }),
        fetch(`${API_URL}/auth/permissions`, {
            headers: { Authorization: `Bearer ${tokenCookie}` }
        }),
    ]);
    if (usersResp.ok) usuarios = await usersResp.json();
    if (permsResp.ok) permisosDisponibles = await permsResp.json();
} catch (e) {
    console.error('No se pudo cargar configuración:', e);
}

const permisosLabels: Record<string, string> = {
    PRODUCT_VIEW: 'Ver productos',
    PRODUCT_CREATE: 'Crear productos',
    PRODUCT_STOCK_EDIT: 'Editar stock',
    PRODUCT_DELETE: 'Eliminar productos',
    CATEGORY_VIEW: 'Ver categorías',
    CATEGORY_MANAGE: 'Gestionar categorías',
    HISTORY_VIEW: 'Ver historial',
    DASHBOARD_VIEW: 'Ver dashboard',
    DATA_EXPORT: 'Exportar datos',
};

const usuariosJSON = JSON.stringify(usuarios);
const permisosJSON = JSON.stringify(permisosDisponibles);
const permisosLabelsJSON = JSON.stringify(permisosLabels);
---

<Layout title="Configuración" activePage="configuracion">
    <div class="config-section">
        <div class="section-header">
            <div>
                <h2 class="section-title">Matriz de permisos</h2>
                <p class="section-desc">Usuarios en filas y permisos por columna.</p>
            </div>
        </div>

        <div id="alert-usuarios" class="alert" style="display:none;"></div>

        <div class="table-wrapper">
            <table id="tabla-permisos">
                <thead>
                <tr>
                    <th>Usuario</th>
                    <th>Rol</th>
                    <th>Estado</th>
                    {permisosDisponibles.map((perm) => (
                        <th>{permisosLabels[perm] ?? perm}</th>
                    ))}
                    <th>Acciones</th>
                </tr>
                </thead>
                <tbody>
                {usuarios.map((u) => (
                    <tr data-username={u.username}>
                        <td><span class="username-badge">@{u.username}</span></td>
                        <td>
                            <span class={`role-badge ${u.role === 'ADMIN' ? 'role-admin' : 'role-user'}`}>
                                {u.role}
                            </span>
                        </td>
                        <td>
                            <span class={`status-badge ${u.enabled ? 'status-active' : 'status-inactive'}`}>
                                {u.enabled ? 'Activo' : 'Inactivo'}
                            </span>
                        </td>
                        {permisosDisponibles.map((perm) => (
                            <td>
                                <label class="switch">
                                    <input
                                        type="checkbox"
                                        data-action="toggle-perm"
                                        data-username={u.username}
                                        data-permission={perm}
                                        checked={u.permissions?.includes(perm)}
                                    />
                                    <span class="slider"></span>
                                </label>
                            </td>
                        ))}
                        <td>
                            <div class="actions-cell">
                                <button
                                    class="btn btn-edit btn-sm"
                                    data-action="toggle-role"
                                    data-username={u.username}
                                    data-current-role={u.role}
                                >
                                    {u.role === 'ADMIN' ? 'Quitar ADMIN' : 'Hacer ADMIN'}
                                </button>
                                <button
                                    class={`btn btn-sm ${u.enabled ? 'btn-danger' : 'btn-success'}`}
                                    data-action="toggle-status"
                                    data-username={u.username}
                                    data-enabled={String(u.enabled)}
                                >
                                    {u.enabled ? 'Desactivar' : 'Activar'}
                                </button>
                            </div>
                        </td>
                    </tr>
                ))}
                </tbody>
            </table>
        </div>
    </div>

    <div class="config-section">
        <div class="section-header">
            <div>
                <h2 class="section-title">Crear usuario</h2>
                <p class="section-desc">Agrega un nuevo usuario al sistema con rol asignado.</p>
            </div>
        </div>

        <div id="alert-crear" class="alert" style="display:none;"></div>

        <form id="form-crear-usuario" class="inline-form">
            <div class="form-row-3">
                <div class="form-group">
                    <label for="new-username">Username *</label>
                    <input type="text" id="new-username" required />
                </div>
                <div class="form-group">
                    <label for="new-password">Contraseña *</label>
                    <input type="password" id="new-password" required minlength="6" />
                </div>
                <div class="form-group">
                    <label for="new-role">Rol *</label>
                    <select id="new-role">
                        <option value="USER">USER</option>
                        <option value="ADMIN">ADMIN</option>
                    </select>
                </div>
            </div>
            <div class="form-actions-inline">
                <button type="submit" class="btn btn-primary">
                    + Crear usuario
                </button>
            </div>
        </form>
    </div>

    <div class="config-section">
        <div class="section-header">
            <div>
                <h2 class="section-title">Cambiar mi contraseña</h2>
                <p class="section-desc">Actualiza la contraseña de tu cuenta actual.</p>
            </div>
        </div>

        <div id="alert-password" class="alert" style="display:none;"></div>

        <form id="form-cambiar-password" class="inline-form">
            <div class="form-row-3">
                <div class="form-group">
                    <label for="pwd-actual">Contraseña actual *</label>
                    <input type="password" id="pwd-actual" required />
                </div>
                <div class="form-group">
                    <label for="pwd-nueva">Nueva contraseña *</label>
                    <input type="password" id="pwd-nueva" required minlength="6" />
                </div>
                <div class="form-group">
                    <label for="pwd-confirmar">Confirmar contraseña *</label>
                    <input type="password" id="pwd-confirmar" required minlength="6" />
                </div>
            </div>
            <div class="form-actions-inline">
                <button type="submit" class="btn btn-primary">
                    Actualizar contraseña
                </button>
            </div>
        </form>
    </div>

</Layout>

<script is:inline define:vars={{ usuariosJSON, permisosJSON, permisosLabelsJSON, apiUrl: API_URL }}>
    const token = localStorage.getItem('token') ?? '';
    const usuarios = JSON.parse(usuariosJSON);
    const permisosDisponibles = JSON.parse(permisosJSON);
    const permisosLabels = JSON.parse(permisosLabelsJSON);

    const statePerms = new Map();
    usuarios.forEach(u => statePerms.set(u.username, new Set(u.permissions ?? [])));

    function mostrarAlerta(seccion, mensaje, tipo) {
        const el = document.getElementById(`alert-${seccion}`);
        el.textContent = mensaje;
        el.className = `alert alert-${tipo}`;
        el.style.display = 'block';
        setTimeout(() => { el.style.display = 'none'; }, 4000);
    }

    async function fetchAuth(url, method, body) {
        const opts = {
            method,
            headers: {
                Authorization: `Bearer ${token}`,
                'Content-Type': 'application/json',
            }
        };
        if (body) opts.body = JSON.stringify(body);
        const resp = await fetch(url, opts);
        const data = await resp.json().catch(() => ({}));
        if (!resp.ok) throw new Error(data.error ?? `Error ${resp.status}`);
        return data;
    }

    async function guardarPermisos(username) {
        const set = statePerms.get(username) ?? new Set();
        const permissions = Array.from(set);
        await fetchAuth(`${apiUrl}/auth/users/${username}/permissions`, 'PUT', { permissions });
    }

    document.addEventListener('change', async (e) => {
        const input = e.target.closest('input[data-action="toggle-perm"]');
        if (!input) return;

        const username = input.dataset.username;
        const permission = input.dataset.permission;
        const checked = input.checked;

        const set = statePerms.get(username) ?? new Set();
        if (checked) set.add(permission); else set.delete(permission);
        statePerms.set(username, set);

        try {
            await guardarPermisos(username);
            mostrarAlerta('usuarios', `Permisos actualizados para @${username}`, 'success');
        } catch (err) {
            input.checked = !checked;
            if (checked) set.delete(permission); else set.add(permission);
            mostrarAlerta('usuarios', err.message, 'error');
        }
    });

    document.addEventListener('click', async (e) => {
        const btn = e.target.closest('[data-action]');
        if (!btn || btn.dataset.action === 'toggle-perm') return;

        const action = btn.dataset.action;
        const username = btn.dataset.username;

        if (action === 'toggle-role') {
            const currentRole = btn.dataset.currentRole;
            const newRole = currentRole === 'ADMIN' ? 'USER' : 'ADMIN';

            try {
                await fetchAuth(`${apiUrl}/auth/users/${username}/role?role=${newRole}`, 'PUT');
                window.location.reload();
            } catch (err) {
                mostrarAlerta('usuarios', err.message, 'error');
            }
        }

        if (action === 'toggle-status') {
            const isEnabled = btn.dataset.enabled === 'true';
            const accion = isEnabled ? 'desactivar' : 'activar';
            if (!confirm(`¿${accion.charAt(0).toUpperCase() + accion.slice(1)} la cuenta de @${username}?`)) return;

            try {
                await fetchAuth(`${apiUrl}/auth/users/${username}/status`, 'PUT');
                window.location.reload();
            } catch (err) {
                mostrarAlerta('usuarios', err.message, 'error');
            }
        }
    });

    document.getElementById('form-crear-usuario').addEventListener('submit', async (e) => {
        e.preventDefault();
        const username = document.getElementById('new-username').value.trim();
        const password = document.getElementById('new-password').value;
        const role = document.getElementById('new-role').value;

        if (password.length < 6) {
            mostrarAlerta('crear', 'La contraseña debe tener al menos 6 caracteres', 'error');
            return;
        }

        try {
            await fetchAuth(`${apiUrl}/auth/users`, 'POST', { username, password, role });
            mostrarAlerta('crear', `Usuario @${username} creado correctamente como ${role}`, 'success');
            window.location.reload();
        } catch (err) {
            mostrarAlerta('crear', err.message, 'error');
        }
    });

    document.getElementById('form-cambiar-password').addEventListener('submit', async (e) => {
        e.preventDefault();

        const passwordActual = document.getElementById('pwd-actual').value;
        const passwordNuevo = document.getElementById('pwd-nueva').value;
        const passwordConfirmar = document.getElementById('pwd-confirmar').value;

        if (passwordNuevo !== passwordConfirmar) {
            mostrarAlerta('password', 'Las contraseñas nuevas no coinciden', 'error');
            return;
        }

        try {
            await fetchAuth(`${apiUrl}/auth/password`, 'PUT', {
                passwordActual,
                passwordNuevo,
                passwordConfirmar
            });
            mostrarAlerta('password', 'Contraseña actualizada correctamente', 'success');
            e.target.reset();
        } catch (err) {
            mostrarAlerta('password', err.message, 'error');
        }
    });
</script>

<style>
    .config-section { background: white; border: 1px solid var(--border); border-radius: var(--radius); padding: 28px; margin-bottom: 24px; }
    .section-header { margin-bottom: 20px; padding-bottom: 16px; border-bottom: 1px solid var(--border); }
    .section-title { font-family: var(--font-mono); font-size: 14px; font-weight: 700; letter-spacing: 0.3px; color: var(--text); margin-bottom: 4px; }
    .section-desc { font-size: 13px; color: var(--text-muted); }
    .table-wrapper { overflow-x: auto; }
    table { min-width: 1180px; }
    .username-badge { font-family: var(--font-mono); font-size: 13px; font-weight: 600; color: var(--text); }
    .role-badge { display: inline-block; padding: 3px 10px; border-radius: 20px; font-size: 11px; font-weight: 700; font-family: var(--font-mono); letter-spacing: 0.5px; }
    .role-admin { background: rgba(216, 73, 16, 0.1); color: var(--primary); border: 1px solid rgba(216, 73, 16, 0.2); }
    .role-user { background: var(--light-2); color: var(--text-muted); border: 1px solid var(--border); }
    .status-badge { display: inline-block; padding: 3px 10px; border-radius: 20px; font-size: 11px; font-weight: 600; font-family: var(--font-mono); }
    .status-active { background: var(--success-bg); color: var(--success); border: 1px solid #C8E6C9; }
    .status-inactive { background: var(--error-bg); color: var(--error); border: 1px solid #FFCDD2; }
    .btn-success { background: transparent; color: var(--success); border: 1px solid #C8E6C9; }
    .btn-success:hover { background: var(--success-bg); }

    .switch { position: relative; display: inline-block; width: 36px; height: 20px; }
    .switch input { opacity: 0; width: 0; height: 0; }
    .slider {
        position: absolute;
        cursor: pointer;
        inset: 0;
        background-color: #d5d5d5;
        transition: .2s;
        border-radius: 20px;
    }
    .slider:before {
        position: absolute;
        content: "";
        height: 14px;
        width: 14px;
        left: 3px;
        bottom: 3px;
        background-color: white;
        transition: .2s;
        border-radius: 50%;
    }
    input:checked + .slider { background-color: var(--primary); }
    input:checked + .slider:before { transform: translateX(16px); }

    .inline-form { display: flex; flex-direction: column; gap: 16px; }
    .form-row-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16px; }
    .form-group { display: flex; flex-direction: column; gap: 6px; }
    label { font-size: 12px; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px; }
    input, select { padding: 9px 12px; border: 1px solid var(--border); border-radius: var(--radius); font-size: 14px; background: white; }
    .form-actions-inline { display: flex; justify-content: flex-start; }

    @media (max-width: 900px) {
        .form-row-3 { grid-template-columns: 1fr 1fr; }
        .config-section { padding: 20px; }
    }

    @media (max-width: 600px) {
        .form-row-3 { grid-template-columns: 1fr; }
        .config-section { padding: 14px; }
        .section-title { font-size: 13px; }
    }
</style>
