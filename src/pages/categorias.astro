---
import Layout from '../layouts/Layout.astro';
import { hasPermission, parsePermissions } from '../lib/session';

const API_URL = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:8080';
const token = Astro.cookies.get('token')?.value ?? '';
const role = Astro.cookies.get('role')?.value;
const permissions = parsePermissions(Astro.cookies.get('permissions')?.value, role);
const canView = hasPermission(permissions, 'CATEGORY_VIEW');
const canManage = hasPermission(permissions, 'CATEGORY_MANAGE');

if (!canView) {
    return Astro.redirect('/');
}

let categorias: any[] = [];
try {
    const resp = await fetch(`${API_URL}/categorias`, {
        headers: { Authorization: `Bearer ${token}` }
    });
    if (resp.ok) categorias = await resp.json();
} catch {
    categorias = [];
}

const categoriasJSON = JSON.stringify(categorias);
---

<Layout title="Categorías" activePage="categorias">

    {canManage && (
            <button class="btn btn-primary" id="btn-nuevo" slot="actions">
                + Nueva categoría
            </button>
    )}

    <div id="alert" class="alert" style="display:none;"></div>

    <div class="table-wrapper">
        <table>
            <thead>
            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Padre</th>
                <th>Descripción</th>
                {canManage && <th>Acciones</th>}
            </tr>
            </thead>
            <tbody>
            {categorias.map(c => (
                    <tr>
                        <td><span class="id-badge">#{c.id}</span></td>
                        <td><strong>{c.nombre}</strong></td>
                        <td>{c.parent?.nombre ?? <span class="muted">Raíz</span>}</td>
                        <td>{c.descripcion ?? <span class="muted">—</span>}</td>
                        {canManage && (
                                <td>
                                    <div class="actions-cell">
                                        <button class="btn btn-edit btn-sm" data-id={c.id} data-action="edit">Editar</button>
                                        <button class="btn btn-danger btn-sm" data-id={c.id} data-action="delete">Eliminar</button>
                                    </div>
                                </td>
                        )}
                    </tr>
            ))}
            </tbody>
        </table>
    </div>
</Layout>

{canManage && (
<div id="modal" class="modal-overlay" style="display:none;">
    <div class="modal-box">
        <div class="modal-header">
            <h2 id="modal-title" class="modal-title">Nueva Categoría</h2>
            <button id="modal-close" class="modal-close" type="button">✕</button>
        </div>
        <form id="categoria-form" class="form">
            <input type="hidden" id="categoria-id" />
            <div class="form-group">
                <label for="nombre">Nombre *</label>
                <input type="text" id="nombre" required />
            </div>
            <div class="form-group">
                <label for="parent-id">Categoría padre</label>
                <select id="parent-id">
                    <option value="">Sin padre (raíz)</option>
                    {categorias.map(c => (
                        <option value={c.id}>{c.nombre}</option>
                    ))}
                </select>
            </div>
            <div class="form-group">
                <label for="descripcion">Descripción</label>
                <textarea id="descripcion" rows="3"></textarea>
            </div>
            <div class="form-actions">
                <button type="button" id="btn-cancelar" class="btn">Cancelar</button>
                <button type="submit" class="btn btn-primary">Guardar</button>
            </div>
        </form>
    </div>
</div>
    )}

<script is:inline define:vars={{ categoriasJSON, canManage, apiUrl: API_URL }}>
    if (canManage) {
        const categorias = JSON.parse(categoriasJSON);
        const token = localStorage.getItem('token') ?? '';
        const modal = document.getElementById('modal');
        const form = document.getElementById('categoria-form');
        const alertEl = document.getElementById('alert');

        const mostrarAlerta = (mensaje, tipo = 'error') => {
            alertEl.textContent = mensaje;
            alertEl.className = `alert alert-${tipo}`;
            alertEl.style.display = 'block';
            setTimeout(() => { alertEl.style.display = 'none'; }, 3500);
        };

        const abrirModal = () => { modal.style.display = 'flex'; };
        const cerrarModal = () => {
            modal.style.display = 'none';
            form.reset();
            document.getElementById('categoria-id').value = '';
            document.getElementById('modal-title').textContent = 'Nueva Categoría';
        };

        document.getElementById('btn-nuevo')?.addEventListener('click', abrirModal);
        document.getElementById('btn-cancelar')?.addEventListener('click', cerrarModal);
        document.getElementById('modal-close')?.addEventListener('click', cerrarModal);

        document.addEventListener('click', async (e) => {
            const btn = e.target.closest('[data-action]');
            if (!btn) return;

            const id = parseInt(btn.dataset.id, 10);
            const action = btn.dataset.action;

            if (action === 'edit') {
                const c = categorias.find(x => x.id === id);
                if (!c) return;
                document.getElementById('modal-title').textContent = 'Editar Categoría';
                document.getElementById('categoria-id').value = c.id;
                document.getElementById('nombre').value = c.nombre;
                document.getElementById('descripcion').value = c.descripcion ?? '';
                document.getElementById('parent-id').value = c.parent?.id ? String(c.parent.id) : '';
                abrirModal();
                return;
            }

            if (action === 'delete') {
                if (!confirm('¿Eliminar categoría?')) return;
                try {
                    const resp = await fetch(`${apiUrl}/categorias/${id}`, {
                        method: 'DELETE',
                        headers: { Authorization: `Bearer ${token}` }
                    });
                    if (!resp.ok) {
                        const err = await resp.json().catch(() => ({}));
                        throw new Error(err.error ?? 'No se pudo eliminar la categoría');
                    }
                    window.location.reload();
                } catch (err) {
                    mostrarAlerta(err.message);
                }
            }
        });

        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            const id = document.getElementById('categoria-id').value;
            const parentId = document.getElementById('parent-id').value;

            const data = {
                nombre: document.getElementById('nombre').value.trim(),
                descripcion: document.getElementById('descripcion').value.trim(),
                parent: parentId ? { id: parseInt(parentId, 10) } : null
            };

            try {
                const resp = await fetch(`${apiUrl}/categorias${id ? `/${id}` : ''}`, {
                    method: id ? 'PUT' : 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        Authorization: `Bearer ${token}`
                    },
                    body: JSON.stringify(data)
                });
                if (!resp.ok) {
                    const err = await resp.json().catch(() => ({}));
                    throw new Error(err.error ?? 'No se pudo guardar la categoría');
                }
                window.location.reload();
            } catch (err) {
                mostrarAlerta(err.message);
            }
        });
    }
</script>

<style>
    .id-badge { font-family: var(--font-mono), monospace; font-size: 12px; color: var(--text-muted); }
    .modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 200; padding: 12px; }
    .modal-box { background: white; border-radius: var(--radius); width: 90%; max-width: 440px; padding: 28px; max-height: calc(100vh - 24px); overflow-y: auto; }
    .modal-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; }
    .modal-title { font-family: var(--font-mono), monospace; font-size: 16px; font-weight: 700; }
    .form { display: flex; flex-direction: column; gap: 16px; }
    label { font-size: 13px; font-weight: 500; color: var(--text-muted); }
    input, textarea, select { padding: 9px 12px; border: 1px solid var(--border); border-radius: var(--radius); font-family: var(--font-sans), sans-serif; font-size: 14px; }
    .form-actions { display: flex; justify-content: flex-end; gap: 10px; margin-top: 8px; }
    @media (max-width: 700px) {
        .modal-box {
            width: 100%;
            padding: 18px;
        }
        .form-actions {
            flex-direction: column-reverse;
        }
        .form-actions .btn {
            width: 100%;
            justify-content: center;
        }
    }
</style>
