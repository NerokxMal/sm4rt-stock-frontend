---
import Layout from '../layouts/Layout.astro';

const API_URL = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:8080';

// Cargamos los últimos 30 días por defecto en el servidor.
// El usuario puede cambiar el rango desde el frontend sin recargar.
let movimientos: {
    id: number;
    tipo: string;
    cantidad: number;
    stockAnterior: number;
    stockNuevo: number;
    fecha: string;
    producto: { id: number; nombre: string } | null;
    usuario: { username: string } | null;
}[] = [];

let productos: { id: number; nombre: string }[] = [];

try {
    const [movResp, prodResp] = await Promise.all([
        fetch(`${API_URL}/movimientos`),
        fetch(`${API_URL}/productos`),
    ]);
    if (movResp.ok)  movimientos = await movResp.json();
    if (prodResp.ok) productos   = await prodResp.json();
} catch (e) {
    console.error('Error cargando histórico:', e);
}

// Totales para las tarjetas de resumen (calculados en el servidor)
const totalEntradas = movimientos
    .filter(m => m.tipo === 'ENTRADA')
    .reduce((s, m) => s + m.cantidad, 0);

const totalSalidas = movimientos
    .filter(m => m.tipo === 'SALIDA')
    .reduce((s, m) => s + m.cantidad, 0);

const totalMovimientos = movimientos.length;

// Serializar para el cliente
const movimientosJSON = JSON.stringify(movimientos);
const productosJSON   = JSON.stringify(productos);
---

<Layout title="Histórico" activePage="historico">

    <!-- ─── TARJETAS DE RESUMEN ────────────────────────────────────── -->
    <div class="cards-grid" style="margin-bottom: 24px;">
        <div class="card">
            <p class="card-label">Total movimientos</p>
            <p class="card-value" id="stat-total">{totalMovimientos}</p>
        </div>
        <div class="card">
            <p class="card-label">Unidades entradas</p>
            <p class="card-value" id="stat-entradas" style="color: var(--success)">{totalEntradas}</p>
        </div>
        <div class="card">
            <p class="card-label">Unidades salidas</p>
            <p class="card-value" id="stat-salidas" style="color: var(--primary)">{totalSalidas}</p>
        </div>
        <div class="card">
            <p class="card-label">Balance neto</p>
            <p class="card-value" id="stat-balance"
               style={`color: ${totalEntradas - totalSalidas >= 0 ? 'var(--success)' : 'var(--primary)'}`}>
                {totalEntradas - totalSalidas >= 0 ? '+' : ''}{totalEntradas - totalSalidas}
            </p>
        </div>
    </div>

    <!-- ─── FILTROS ────────────────────────────────────────────────── -->
    <div class="filtros-card">
        <div class="filtros-grid">

            <div class="form-group">
                <label for="filtro-desde">Desde</label>
                <input type="date" id="filtro-desde" />
            </div>

            <div class="form-group">
                <label for="filtro-hasta">Hasta</label>
                <input type="date" id="filtro-hasta" />
            </div>

            <div class="form-group">
                <label for="filtro-tipo">Tipo</label>
                <select id="filtro-tipo">
                    <option value="">Todos</option>
                    <option value="ENTRADA">Entradas</option>
                    <option value="SALIDA">Salidas</option>
                </select>
            </div>

            <div class="form-group">
                <label for="filtro-producto">Producto</label>
                <select id="filtro-producto">
                    <option value="">Todos los productos</option>
                    {productos.map(p => (
                        <option value={p.id}>{p.nombre}</option>
                    ))}
                </select>
            </div>

            <div class="form-group">
                <label for="filtro-texto">Buscar</label>
                <input type="text" id="filtro-texto" placeholder="Nombre del producto..." />
            </div>

            <div class="form-group form-group-actions">
                <label>&nbsp;</label>
                <div style="display:flex; gap:8px;">
                    <button id="btn-filtrar" class="btn btn-primary">Filtrar</button>
                    <button id="btn-limpiar" class="btn">Limpiar</button>
                </div>
            </div>

        </div>
    </div>

    <!-- ─── GRÁFICAS ──────────────────────────────────────────────── -->
    <div class="charts-grid" style="margin-bottom: 24px;">

        <!-- Línea: entradas vs salidas por día -->
        <div class="chart-card">
            <p class="chart-title">Entradas vs Salidas por día</p>
            <div class="chart-container-tall">
                <canvas id="chart-linea-historico"></canvas>
            </div>
        </div>

        <!-- Barras: top productos con más movimientos -->
        <div class="chart-card">
            <p class="chart-title">Top productos por volumen</p>
            <div class="chart-container-tall">
                <canvas id="chart-barras-productos"></canvas>
            </div>
        </div>

    </div>

    <!-- ─── TABLA DE MOVIMIENTOS ──────────────────────────────────── -->
    <div class="table-wrapper">
        <div class="table-toolbar">
            <span id="count-label" class="count-label">
                {totalMovimientos} movimiento{totalMovimientos !== 1 ? 's' : ''}
            </span>
        </div>
        <table>
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Producto</th>
                    <th>Tipo</th>
                    <th>Cantidad</th>
                    <th>Stock anterior</th>
                    <th>Stock nuevo</th>
                    <th>Usuario</th>
                </tr>
            </thead>
            <tbody id="tbody-movimientos">
                {movimientos.map(m => (
                    <tr>
                        <td class="mono" style="font-size:12px; color:var(--text-muted)">
                            {new Date(m.fecha).toLocaleString('es-CO')}
                        </td>
                        <td><strong>{m.producto?.nombre ?? '—'}</strong></td>
                        <td>
                            <span class={`tipo-badge ${m.tipo === 'ENTRADA' ? 'tipo-entrada' : 'tipo-salida'}`}>
                                {m.tipo === 'ENTRADA' ? '▲' : '▼'} {m.tipo}
                            </span>
                        </td>
                        <td class="mono"><strong>{m.cantidad}</strong></td>
                        <td class="mono" style="color:var(--text-muted)">{m.stockAnterior}</td>
                        <td class="mono">{m.stockNuevo}</td>
                        <td style="color:var(--text-muted); font-size:13px">
                            @{m.usuario?.username ?? 'sistema'}
                        </td>
                    </tr>
                ))}
            </tbody>
        </table>
        <div id="tabla-vacia" class="tabla-vacia" style="display:none;">
            Sin movimientos para los filtros seleccionados.
        </div>
    </div>

</Layout>

<script is:inline define:vars={{ movimientosJSON, productosJSON, apiUrl: 'http://localhost:8080' }}>

    // ─── ESTADO ───────────────────────────────────────────────────────
    let todosLosMovimientos = JSON.parse(movimientosJSON);
    let movimientosFiltrados = [...todosLosMovimientos];
    let chartLinea = null;
    let chartBarras = null;

    // ─── INICIALIZAR FECHAS POR DEFECTO ───────────────────────────────
    // Muestra los últimos 30 días al cargar
    const hoy = new Date();
    const hace30 = new Date(hoy);
    hace30.setDate(hace30.getDate() - 30);

    document.getElementById('filtro-hasta').value = hoy.toISOString().split('T')[0];
    document.getElementById('filtro-desde').value = hace30.toISOString().split('T')[0];

    // ─── CARGAR CHART.JS ──────────────────────────────────────────────
    function inicializar() {
        renderTabla(todosLosMovimientos);
        renderGraficas(todosLosMovimientos);
    }

    if (typeof Chart === 'undefined') {
        const s = document.createElement('script');
        s.src = 'https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js';
        s.onload = inicializar;
        document.head.appendChild(s);
    } else {
        inicializar();
    }

    // ─── FILTRAR (fetch al backend con parámetros) ─────────────────────
    document.getElementById('btn-filtrar').addEventListener('click', async () => {
        const desde    = document.getElementById('filtro-desde').value;
        const hasta    = document.getElementById('filtro-hasta').value;
        const tipo     = document.getElementById('filtro-tipo').value;
        const producto = document.getElementById('filtro-producto').value;
        const texto    = document.getElementById('filtro-texto').value.trim().toLowerCase();

        // Construir URL con parámetros opcionales
        const params = new URLSearchParams();
        if (desde) params.append('desde', desde);
        if (hasta) params.append('hasta', hasta);
        if (tipo)  params.append('tipo', tipo);

        const btn = document.getElementById('btn-filtrar');
        btn.disabled = true;
        btn.textContent = 'Filtrando...';

        try {
            const resp = await fetch(`${apiUrl}/movimientos?${params.toString()}`);
            let data = await resp.json();

            // Filtros en cliente: producto y texto
            if (producto) {
                data = data.filter(m => m.producto?.id == producto);
            }
            if (texto) {
                data = data.filter(m =>
                    m.producto?.nombre?.toLowerCase().includes(texto)
                );
            }

            todosLosMovimientos = data;
            movimientosFiltrados = [...data];

            renderTabla(data);
            renderGraficas(data);
            actualizarTarjetas(data);

        } catch (err) {
            console.error('Error filtrando:', err);
        } finally {
            btn.disabled = false;
            btn.textContent = 'Filtrar';
        }
    });

    // ─── LIMPIAR FILTROS ──────────────────────────────────────────────
    document.getElementById('btn-limpiar').addEventListener('click', () => {
        document.getElementById('filtro-tipo').value     = '';
        document.getElementById('filtro-producto').value = '';
        document.getElementById('filtro-texto').value    = '';
        document.getElementById('btn-filtrar').click();
    });

    // ─── RENDER TABLA ─────────────────────────────────────────────────
    function renderTabla(data) {
        const tbody = document.getElementById('tbody-movimientos');
        const vacia = document.getElementById('tabla-vacia');
        const count = document.getElementById('count-label');

        count.textContent = `${data.length} movimiento${data.length !== 1 ? 's' : ''}`;

        if (data.length === 0) {
            tbody.innerHTML = '';
            vacia.style.display = 'block';
            return;
        }

        vacia.style.display = 'none';
        tbody.innerHTML = data.map(m => {
            const fecha  = new Date(m.fecha).toLocaleString('es-CO');
            const nombre = m.producto?.nombre ?? '—';
            const tipo   = m.tipo === 'ENTRADA' ? '▲ ENTRADA' : '▼ SALIDA';
            const clase  = m.tipo === 'ENTRADA' ? 'tipo-entrada' : 'tipo-salida';
            const user   = m.usuario?.username ?? 'sistema';
            return `
                <tr>
                    <td class="mono" style="font-size:12px;color:var(--text-muted)">${fecha}</td>
                    <td><strong>${nombre}</strong></td>
                    <td><span class="tipo-badge ${clase}">${tipo}</span></td>
                    <td class="mono"><strong>${m.cantidad}</strong></td>
                    <td class="mono" style="color:var(--text-muted)">${m.stockAnterior}</td>
                    <td class="mono">${m.stockNuevo}</td>
                    <td style="color:var(--text-muted);font-size:13px">@${user}</td>
                </tr>`;
        }).join('');
    }

    // ─── ACTUALIZAR TARJETAS ──────────────────────────────────────────
    function actualizarTarjetas(data) {
        const entradas = data.filter(m => m.tipo === 'ENTRADA').reduce((s, m) => s + m.cantidad, 0);
        const salidas  = data.filter(m => m.tipo === 'SALIDA').reduce((s, m) => s + m.cantidad, 0);
        const balance  = entradas - salidas;

        document.getElementById('stat-total').textContent    = data.length;
        document.getElementById('stat-entradas').textContent = entradas;
        document.getElementById('stat-salidas').textContent  = salidas;
        document.getElementById('stat-balance').textContent  = (balance >= 0 ? '+' : '') + balance;
        document.getElementById('stat-balance').style.color  = balance >= 0 ? 'var(--success)' : 'var(--primary)';
    }

    // ─── RENDER GRÁFICAS ──────────────────────────────────────────────
    function renderGraficas(data) {
        renderLineaHistorico(data);
        renderBarrasProductos(data);
    }

    // Gráfica de línea: entradas vs salidas agrupadas por día
    function renderLineaHistorico(data) {
        const fmt = (fecha) => {
            const d = new Date(fecha);
            return `${String(d.getDate()).padStart(2,'0')}/${String(d.getMonth()+1).padStart(2,'0')}`;
        };

        // Agrupar por día
        const porDia = {};
        data.forEach(m => {
            const dia = fmt(m.fecha);
            if (!porDia[dia]) porDia[dia] = { entradas: 0, salidas: 0 };
            if (m.tipo === 'ENTRADA') porDia[dia].entradas += m.cantidad;
            else                     porDia[dia].salidas  += m.cantidad;
        });

        // Ordenar por fecha (el formato dd/MM es ordenable lexicográficamente dentro del mes)
        const dias      = Object.keys(porDia).sort();
        const entradas  = dias.map(d => porDia[d].entradas);
        const salidas   = dias.map(d => porDia[d].salidas);

        const canvas = document.getElementById('chart-linea-historico');
        if (!canvas) return;

        // Destruir chart anterior para evitar "Canvas already in use"
        if (chartLinea) { chartLinea.destroy(); chartLinea = null; }

        if (dias.length === 0) {
            canvas.parentElement.innerHTML = '<p class="chart-empty">Sin datos para el período seleccionado.</p>';
            return;
        }

        chartLinea = new Chart(canvas.getContext('2d'), {
            type: 'line',
            data: {
                labels: dias,
                datasets: [
                    {
                        label: 'Entradas',
                        data: entradas,
                        borderColor: '#1D9E75',
                        backgroundColor: 'rgba(29,158,117,0.08)',
                        borderWidth: 2,
                        tension: 0.3,
                        fill: true,
                        pointRadius: 4,
                        pointHoverRadius: 6,
                        pointBackgroundColor: '#1D9E75',
                    },
                    {
                        label: 'Salidas',
                        data: salidas,
                        borderColor: '#D84910',
                        backgroundColor: 'rgba(216,73,16,0.08)',
                        borderWidth: 2,
                        tension: 0.3,
                        fill: true,
                        pointRadius: 4,
                        pointHoverRadius: 6,
                        pointBackgroundColor: '#D84910',
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                interaction: { mode: 'index', intersect: false },
                scales: {
                    y: {
                        beginAtZero: true,
                        grid: { color: 'rgba(0,0,0,0.04)' },
                        border: { display: false },
                        ticks: {
                            font: { size: 11, family: "'DM Sans', sans-serif" },
                            color: '#888880',
                            callback: v => Number.isInteger(v) ? v : null,
                        }
                    },
                    x: {
                        grid: { display: false },
                        border: { display: false },
                        ticks: {
                            font: { size: 11, family: "'DM Sans', sans-serif" },
                            color: '#888880',
                            maxTicksLimit: 15,
                        }
                    }
                },
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: {
                            padding: 16,
                            font: { size: 12, family: "'DM Sans', sans-serif" },
                            color: '#888880',
                            usePointStyle: true,
                            pointStyleWidth: 8,
                        }
                    }
                }
            }
        });
    }

    // Gráfica de barras: top 8 productos por volumen total (entradas + salidas)
    function renderBarrasProductos(data) {
        // Agrupar por producto
        const porProducto = {};
        data.forEach(m => {
            const nombre = m.producto?.nombre ?? 'Sin nombre';
            if (!porProducto[nombre]) porProducto[nombre] = { entradas: 0, salidas: 0 };
            if (m.tipo === 'ENTRADA') porProducto[nombre].entradas += m.cantidad;
            else                     porProducto[nombre].salidas  += m.cantidad;
        });

        // Ordenar por volumen total y tomar los top 8
        const sorted = Object.entries(porProducto)
            .map(([nombre, v]) => ({ nombre, ...v, total: v.entradas + v.salidas }))
            .sort((a, b) => b.total - a.total)
            .slice(0, 8);

        const canvas = document.getElementById('chart-barras-productos');
        if (!canvas) return;

        if (chartBarras) { chartBarras.destroy(); chartBarras = null; }

        if (sorted.length === 0) {
            canvas.parentElement.innerHTML = '<p class="chart-empty">Sin datos para el período seleccionado.</p>';
            return;
        }

        chartBarras = new Chart(canvas.getContext('2d'), {
            type: 'bar',
            data: {
                labels: sorted.map(p => p.nombre),
                datasets: [
                    {
                        label: 'Entradas',
                        data: sorted.map(p => p.entradas),
                        backgroundColor: 'rgba(29,158,117,0.75)',
                        borderRadius: 4,
                        borderSkipped: false,
                    },
                    {
                        label: 'Salidas',
                        data: sorted.map(p => p.salidas),
                        backgroundColor: 'rgba(216,73,16,0.75)',
                        borderRadius: 4,
                        borderSkipped: false,
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                // Barras agrupadas (no apiladas) para comparar entradas y salidas
                // de cada producto directamente
                scales: {
                    y: {
                        beginAtZero: true,
                        grid: { color: 'rgba(0,0,0,0.04)' },
                        border: { display: false },
                        ticks: {
                            font: { size: 11, family: "'DM Sans', sans-serif" },
                            color: '#888880',
                            callback: v => Number.isInteger(v) ? v : null,
                        }
                    },
                    x: {
                        grid: { display: false },
                        border: { display: false },
                        ticks: {
                            font: { size: 11, family: "'DM Sans', sans-serif" },
                            color: '#888880',
                            // Truncar nombres largos para que quepan
                            callback: function(val) {
                                const label = this.getLabelForValue(val);
                                return label.length > 12 ? label.substring(0, 12) + '…' : label;
                            }
                        }
                    }
                },
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: {
                            padding: 16,
                            font: { size: 12, family: "'DM Sans', sans-serif" },
                            color: '#888880',
                            usePointStyle: true,
                            pointStyleWidth: 8,
                        }
                    },
                    tooltip: {
                        callbacks: {
                            // Mostrar el nombre completo en el tooltip aunque esté truncado en el eje
                            title: (items) => items[0].label,
                        }
                    }
                }
            }
        });
    }
</script>

<style>
    /* ─── FILTROS ──────────────────────────────────────────────────── */

    .filtros-card {
        background: white;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 20px 24px;
        margin-bottom: 24px;
    }

    .filtros-grid {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr 1fr 1fr auto;
        gap: 16px;
        align-items: end;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .form-group-actions {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    label {
        font-size: 11px;
        font-weight: 700;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.5px;
        font-family: var(--font-mono);
    }

    input[type="date"],
    input[type="text"],
    select {
        padding: 8px 12px;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        font-family: var(--font-sans);
        font-size: 13px;
        color: var(--text);
        background: white;
        transition: border-color 0.15s;
        height: 36px;
    }

    input:focus, select:focus {
        outline: none;
        border-color: var(--primary);
        box-shadow: 0 0 0 3px var(--primary-dim);
    }

    /* ─── GRÁFICAS ─────────────────────────────────────────────────── */

    .charts-grid {
        display: grid;
        grid-template-columns: 3fr 2fr;
        gap: 20px;
    }

    .chart-card {
        background: white;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 24px;
    }

    .chart-title {
        font-family: var(--font-mono);
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: var(--text-muted);
        margin-bottom: 16px;
    }

    /* Más alta que el dashboard para mayor detalle */
    .chart-container-tall {
        position: relative;
        height: 300px;
    }

    .chart-empty {
        color: var(--text-muted);
        font-size: 13px;
        text-align: center;
        padding: 60px 0;
    }

    /* ─── TABLA ────────────────────────────────────────────────────── */

    .table-toolbar {
        padding: 12px 20px;
        border-bottom: 1px solid var(--border);
        background: var(--light);
        border-radius: var(--radius) var(--radius) 0 0;
    }

    .count-label {
        font-family: var(--font-mono);
        font-size: 11px;
        color: var(--text-muted);
        letter-spacing: 0.5px;
    }

    .tipo-badge {
        display: inline-block;
        padding: 3px 8px;
        border-radius: 4px;
        font-size: 11px;
        font-weight: 700;
        font-family: var(--font-mono);
        letter-spacing: 0.3px;
    }

    .tipo-entrada {
        background: var(--success-bg);
        color: var(--success);
    }

    .tipo-salida {
        background: var(--error-bg);
        color: var(--error);
    }

    .tabla-vacia {
        padding: 40px;
        text-align: center;
        color: var(--text-muted);
        font-size: 14px;
    }

    .mono {
        font-family: var(--font-mono);
        font-size: 13px;
    }

    /* ─── RESPONSIVE ───────────────────────────────────────────────── */

    @media (max-width: 1100px) {
        .filtros-grid {
            grid-template-columns: 1fr 1fr 1fr;
        }
        .charts-grid {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 700px) {
        .filtros-grid {
            grid-template-columns: 1fr 1fr;
        }
    }
</style>