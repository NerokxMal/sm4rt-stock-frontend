---
import Layout from '../layouts/Layout.astro';
import { hasPermission, parsePermissions } from '../lib/session';

const API_URL = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:8080';
const token = Astro.cookies.get('token')?.value ?? '';
const role = Astro.cookies.get('role')?.value;
const permissions = parsePermissions(Astro.cookies.get('permissions')?.value, role);
const canView = hasPermission(permissions, 'HISTORY_VIEW');
const canExport = hasPermission(permissions, 'DATA_EXPORT');

if (!canView) {
    return Astro.redirect('/');
}

let movimientos: any[] = [];
let productos: { id: number; nombre: string }[] = [];

try {
    const [movResp, prodResp] = await Promise.all([
        fetch(`${API_URL}/movimientos`, { headers: { Authorization: `Bearer ${token}` } }),
        fetch(`${API_URL}/productos`, { headers: { Authorization: `Bearer ${token}` } }),
    ]);
    if (movResp.ok)  movimientos = await movResp.json();
    if (prodResp.ok) productos   = await prodResp.json();
} catch (e) {
    console.error('Error cargando histórico:', e);
}

const contarEntradas = (data: any[]) => data
    .filter(m => m.tipo === 'ENTRADA' || (m.tipo === 'AJUSTE' && m.stockNuevo >= m.stockAnterior))
    .reduce((s, m) => s + m.cantidad, 0);

const contarSalidas = (data: any[]) => data
    .filter(m => m.tipo === 'SALIDA' || (m.tipo === 'AJUSTE' && m.stockNuevo < m.stockAnterior))
    .reduce((s, m) => s + m.cantidad, 0);

const totalEntradas = contarEntradas(movimientos);
const totalSalidas = contarSalidas(movimientos);
const totalMovimientos = movimientos.length;
const movimientosJSON = JSON.stringify(movimientos);
const productosJSON = JSON.stringify(productos);
---

<Layout title="Histórico" activePage="historico">

    {canExport && (
        <div slot="actions" class="actions-header-group">
            <button class="btn" id="btn-export-csv">Exportar CSV</button>
            <button class="btn" id="btn-export-pdf">Exportar PDF</button>
        </div>
    )}

    <div class="cards-grid" style="margin-bottom: 24px;">
        <div class="card">
            <p class="card-label">Total movimientos</p>
            <p class="card-value" id="stat-total">{totalMovimientos}</p>
        </div>
        <div class="card">
            <p class="card-label">Unidades entradas</p>
            <p class="card-value" id="stat-entradas" style="color: var(--success)">{totalEntradas}</p>
        </div>
        <div class="card">
            <p class="card-label">Unidades salidas</p>
            <p class="card-value" id="stat-salidas" style="color: var(--primary)">{totalSalidas}</p>
        </div>
        <div class="card">
            <p class="card-label">Balance neto</p>
            <p class="card-value" id="stat-balance"
               style={`color: ${totalEntradas - totalSalidas >= 0 ? 'var(--success)' : 'var(--primary)'}`}>
                {totalEntradas - totalSalidas >= 0 ? '+' : ''}{totalEntradas - totalSalidas}
            </p>
        </div>
    </div>

    <div class="filtros-card">
        <div class="filtros-grid">
            <div class="form-group">
                <label for="filtro-desde">Desde</label>
                <input type="date" id="filtro-desde" />
            </div>

            <div class="form-group">
                <label for="filtro-hasta">Hasta</label>
                <input type="date" id="filtro-hasta" />
            </div>

            <div class="form-group">
                <label for="filtro-tipo">Tipo</label>
                <select id="filtro-tipo">
                    <option value="">Todos</option>
                    <option value="ENTRADA">Entradas</option>
                    <option value="SALIDA">Salidas</option>
                    <option value="AJUSTE">Ajustes</option>
                </select>
            </div>

            <div class="form-group">
                <label for="filtro-producto">Producto</label>
                <select id="filtro-producto">
                    <option value="">Todos los productos</option>
                    {productos.map(p => (
                        <option value={p.id}>{p.nombre}</option>
                    ))}
                </select>
            </div>

            <div class="form-group">
                <label for="filtro-texto">Buscar</label>
                <input type="text" id="filtro-texto" placeholder="Nombre del producto..." />
            </div>

            <div class="form-group form-group-actions">
                <label>&nbsp;</label>
                <div class="filtros-actions">
                    <button id="btn-filtrar" class="btn btn-primary">Filtrar</button>
                    <button id="btn-limpiar" class="btn">Limpiar</button>
                </div>
            </div>
        </div>
    </div>

    <div class="charts-grid" style="margin-bottom: 24px;">
        <div class="chart-card">
            <p class="chart-title">Entradas vs Salidas por día</p>
            <div class="chart-container-tall">
                <canvas id="chart-linea-historico"></canvas>
            </div>
        </div>

        <div class="chart-card">
            <p class="chart-title">Top productos por volumen</p>
            <div class="chart-container-tall">
                <canvas id="chart-barras-productos"></canvas>
            </div>
        </div>
    </div>

    <div class="table-wrapper">
        <div class="table-toolbar">
            <span id="count-label" class="count-label">
                {totalMovimientos} movimiento{totalMovimientos !== 1 ? 's' : ''}
            </span>
        </div>
        <table>
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Producto</th>
                    <th>Tipo</th>
                    <th>Cantidad</th>
                    <th>Stock anterior</th>
                    <th>Stock nuevo</th>
                    <th>Motivo</th>
                    <th>Usuario</th>
                </tr>
            </thead>
            <tbody id="tbody-movimientos">
                {movimientos.map(m => (
                    <tr>
                        <td class="mono" style="font-size:12px; color:var(--text-muted)">
                            {new Date(m.fecha).toLocaleString('es-CO')}
                        </td>
                        <td><strong>{m.producto?.nombre ?? '—'}</strong></td>
                        <td>
                            <span class={`tipo-badge ${m.tipo === 'AJUSTE' ? 'tipo-ajuste' : (m.tipo === 'ENTRADA' ? 'tipo-entrada' : 'tipo-salida')}`}>
                                {m.tipo}
                            </span>
                        </td>
                        <td class="mono"><strong>{m.cantidad}</strong></td>
                        <td class="mono" style="color:var(--text-muted)">{m.stockAnterior}</td>
                        <td class="mono">{m.stockNuevo}</td>
                        <td style="font-size:12px">{m.motivo ?? '—'}</td>
                        <td style="color:var(--text-muted); font-size:13px">
                            @{m.usuario?.username ?? 'sistema'}
                        </td>
                    </tr>
                ))}
            </tbody>
        </table>
        <div id="tabla-vacia" class="tabla-vacia" style="display:none;">
            Sin movimientos para los filtros seleccionados.
        </div>
    </div>

</Layout>

<script is:inline define:vars={{ movimientosJSON, apiUrl: API_URL, canExport }}>
    let todosLosMovimientos = JSON.parse(movimientosJSON);
    let chartLinea = null;
    let chartBarras = null;
    const token = localStorage.getItem('token') ?? '';

    const hoy = new Date();
    const hace30 = new Date(hoy);
    hace30.setDate(hace30.getDate() - 30);

    const dateToInput = (d) => new Date(d.getTime() - d.getTimezoneOffset() * 60000).toISOString().split('T')[0];
    document.getElementById('filtro-hasta').value = dateToInput(hoy);
    document.getElementById('filtro-desde').value = dateToInput(hace30);

    const isEntrada = (m) => m.tipo === 'ENTRADA' || (m.tipo === 'AJUSTE' && m.stockNuevo >= m.stockAnterior);
    const isSalida = (m) => m.tipo === 'SALIDA' || (m.tipo === 'AJUSTE' && m.stockNuevo < m.stockAnterior);

    const getTipoVisual = (m) => {
        if (m.tipo === 'AJUSTE') return 'AJUSTE';
        return m.tipo === 'ENTRADA' ? 'ENTRADA' : 'SALIDA';
    };

    if (canExport) {
        const exportar = async (format) => {
            const desde = document.getElementById('filtro-desde').value;
            const hasta = document.getElementById('filtro-hasta').value;
            const tipo = document.getElementById('filtro-tipo').value;
            const params = new URLSearchParams();
            if (desde) params.append('desde', desde);
            if (hasta) params.append('hasta', hasta);
            if (tipo) params.append('tipo', tipo);
            params.append('format', format);

            const resp = await fetch(`${apiUrl}/movimientos/export?${params}`, {
                headers: { Authorization: `Bearer ${token}` }
            });
            if (!resp.ok) return;
            const blob = await resp.blob();
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `movimientos.${format}`;
            a.click();
            URL.revokeObjectURL(url);
        };

        document.getElementById('btn-export-csv')?.addEventListener('click', () => exportar('csv'));
        document.getElementById('btn-export-pdf')?.addEventListener('click', () => exportar('pdf'));
    }

    function inicializar() {
        renderTabla(todosLosMovimientos);
        renderGraficas(todosLosMovimientos);
    }

    if (typeof Chart === 'undefined') {
        const s = document.createElement('script');
        s.src = 'https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js';
        s.onload = inicializar;
        document.head.appendChild(s);
    } else {
        inicializar();
    }

    document.getElementById('btn-filtrar').addEventListener('click', async () => {
        const desde = document.getElementById('filtro-desde').value;
        const hasta = document.getElementById('filtro-hasta').value;
        const tipo = document.getElementById('filtro-tipo').value;
        const producto = document.getElementById('filtro-producto').value;
        const texto = document.getElementById('filtro-texto').value.trim().toLowerCase();

        const params = new URLSearchParams();
        if (desde) params.append('desde', desde);
        if (hasta) params.append('hasta', hasta);
        if (tipo) params.append('tipo', tipo);

        const btn = document.getElementById('btn-filtrar');
        btn.disabled = true;
        btn.textContent = 'Filtrando...';

        try {
            const resp = await fetch(`${apiUrl}/movimientos?${params.toString()}`, {
                headers: { Authorization: `Bearer ${token}` }
            });
            if (!resp.ok) throw new Error('Error al filtrar');
            let data = await resp.json();

            if (producto) data = data.filter(m => m.producto?.id == producto);
            if (texto) data = data.filter(m => m.producto?.nombre?.toLowerCase().includes(texto));

            todosLosMovimientos = data;
            renderTabla(data);
            renderGraficas(data);
            actualizarTarjetas(data);
        } catch (err) {
            console.error(err);
        } finally {
            btn.disabled = false;
            btn.textContent = 'Filtrar';
        }
    });

    document.getElementById('btn-limpiar').addEventListener('click', () => {
        document.getElementById('filtro-tipo').value = '';
        document.getElementById('filtro-producto').value = '';
        document.getElementById('filtro-texto').value = '';
        document.getElementById('btn-filtrar').click();
    });

    function renderTabla(data) {
        const tbody = document.getElementById('tbody-movimientos');
        const vacia = document.getElementById('tabla-vacia');
        const count = document.getElementById('count-label');
        count.textContent = `${data.length} movimiento${data.length !== 1 ? 's' : ''}`;

        if (data.length === 0) {
            tbody.innerHTML = '';
            vacia.style.display = 'block';
            return;
        }

        vacia.style.display = 'none';
        tbody.innerHTML = data.map(m => {
            const fecha = new Date(m.fecha).toLocaleString('es-CO');
            const tipo = getTipoVisual(m);
            const clase = tipo === 'AJUSTE' ? 'tipo-ajuste' : (tipo === 'ENTRADA' ? 'tipo-entrada' : 'tipo-salida');
            return `
                <tr>
                    <td class="mono" style="font-size:12px;color:var(--text-muted)">${fecha}</td>
                    <td><strong>${m.producto?.nombre ?? '—'}</strong></td>
                    <td><span class="tipo-badge ${clase}">${tipo}</span></td>
                    <td class="mono"><strong>${m.cantidad}</strong></td>
                    <td class="mono" style="color:var(--text-muted)">${m.stockAnterior}</td>
                    <td class="mono">${m.stockNuevo}</td>
                    <td style="font-size:12px">${m.motivo ?? '—'}</td>
                    <td style="color:var(--text-muted);font-size:13px">@${m.usuario?.username ?? 'sistema'}</td>
                </tr>`;
        }).join('');
    }

    function actualizarTarjetas(data) {
        const entradas = data.filter(isEntrada).reduce((s, m) => s + m.cantidad, 0);
        const salidas = data.filter(isSalida).reduce((s, m) => s + m.cantidad, 0);
        const balance = entradas - salidas;

        document.getElementById('stat-total').textContent = data.length;
        document.getElementById('stat-entradas').textContent = entradas;
        document.getElementById('stat-salidas').textContent = salidas;
        document.getElementById('stat-balance').textContent = `${balance >= 0 ? '+' : ''}${balance}`;
        document.getElementById('stat-balance').style.color = balance >= 0 ? 'var(--success)' : 'var(--primary)';
    }

    function renderGraficas(data) {
        renderLineaHistorico(data);
        renderBarrasProductos(data);
    }

    function renderLineaHistorico(data) {
        const porDia = {};
        const labelFor = (fecha) => {
            const d = new Date(fecha);
            return `${String(d.getDate()).padStart(2, '0')}/${String(d.getMonth() + 1).padStart(2, '0')}`;
        };

        data.forEach(m => {
            const dia = labelFor(m.fecha);
            if (!porDia[dia]) porDia[dia] = { entradas: 0, salidas: 0 };
            if (isEntrada(m)) porDia[dia].entradas += m.cantidad;
            else if (isSalida(m)) porDia[dia].salidas += m.cantidad;
        });

        const dias = Object.keys(porDia).sort();
        const entradas = dias.map(d => porDia[d].entradas);
        const salidas = dias.map(d => porDia[d].salidas);
        const canvas = document.getElementById('chart-linea-historico');
        if (!canvas) return;
        if (chartLinea) chartLinea.destroy();
        if (!dias.length) return;

        chartLinea = new Chart(canvas.getContext('2d'), {
            type: 'line',
            data: {
                labels: dias,
                datasets: [
                    {
                        label: 'Entradas',
                        data: entradas,
                        borderColor: '#1D9E75',
                        backgroundColor: 'rgba(29,158,117,0.08)',
                        borderWidth: 2,
                        tension: 0.3,
                        fill: true,
                        pointRadius: 4,
                        pointBackgroundColor: '#1D9E75',
                    },
                    {
                        label: 'Salidas',
                        data: salidas,
                        borderColor: '#D84910',
                        backgroundColor: 'rgba(216,73,16,0.08)',
                        borderWidth: 2,
                        tension: 0.3,
                        fill: true,
                        pointRadius: 4,
                        pointBackgroundColor: '#D84910',
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: v => Number.isInteger(v) ? v : null,
                        }
                    }
                }
            }
        });
    }

    function renderBarrasProductos(data) {
        const porProducto = {};
        data.forEach(m => {
            const nombre = m.producto?.nombre ?? 'Sin nombre';
            if (!porProducto[nombre]) porProducto[nombre] = { entradas: 0, salidas: 0 };
            if (isEntrada(m)) porProducto[nombre].entradas += m.cantidad;
            else if (isSalida(m)) porProducto[nombre].salidas += m.cantidad;
        });

        const sorted = Object.entries(porProducto)
            .map(([nombre, v]) => ({ nombre, ...v, total: v.entradas + v.salidas }))
            .sort((a, b) => b.total - a.total)
            .slice(0, 8);

        const canvas = document.getElementById('chart-barras-productos');
        if (!canvas) return;
        if (chartBarras) chartBarras.destroy();
        if (!sorted.length) return;

        chartBarras = new Chart(canvas.getContext('2d'), {
            type: 'bar',
            data: {
                labels: sorted.map(p => p.nombre),
                datasets: [
                    { label: 'Entradas', data: sorted.map(p => p.entradas), backgroundColor: 'rgba(29,158,117,0.75)' },
                    { label: 'Salidas', data: sorted.map(p => p.salidas), backgroundColor: 'rgba(216,73,16,0.75)' }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
            }
        });
    }
</script>

<style>
    .actions-header-group { display: flex; gap: 8px; flex-wrap: wrap; justify-content: flex-end; }
    .filtros-card { background: white; border: 1px solid var(--border); border-radius: var(--radius); padding: 20px 24px; margin-bottom: 24px; }
    .filtros-grid { display: grid; grid-template-columns: 1fr 1fr 1fr 1fr 1fr auto; gap: 16px; align-items: end; }
    .filtros-actions { display: flex; gap: 8px; flex-wrap: wrap; }
    .form-group { display: flex; flex-direction: column; gap: 6px; }
    .form-group-actions { display: flex; flex-direction: column; gap: 6px; }
    label { font-size: 11px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px; font-family: var(--font-mono); }
    input[type="date"], input[type="text"], select { padding: 8px 12px; border: 1px solid var(--border); border-radius: var(--radius); font-size: 13px; height: 36px; }
    .charts-grid { display: grid; grid-template-columns: 3fr 2fr; gap: 20px; }
    .chart-card { background: white; border: 1px solid var(--border); border-radius: var(--radius); padding: 24px; }
    .chart-title { font-family: var(--font-mono); font-size: 10px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; color: var(--text-muted); margin-bottom: 16px; }
    .chart-container-tall { position: relative; height: 300px; }
    .table-toolbar { padding: 12px 20px; border-bottom: 1px solid var(--border); background: var(--light); border-radius: var(--radius) var(--radius) 0 0; }
    .count-label { font-family: var(--font-mono); font-size: 11px; color: var(--text-muted); letter-spacing: 0.5px; }
    .tipo-badge { display: inline-block; padding: 3px 8px; border-radius: 4px; font-size: 11px; font-weight: 700; font-family: var(--font-mono); letter-spacing: 0.3px; }
    .tipo-entrada { background: var(--success-bg); color: var(--success); }
    .tipo-salida { background: var(--error-bg); color: var(--error); }
    .tipo-ajuste { background: var(--warning-bg); color: var(--warning); }
    .tabla-vacia { padding: 40px; text-align: center; color: var(--text-muted); font-size: 14px; }
    .mono { font-family: var(--font-mono); font-size: 13px; }
    @media (max-width: 1100px) {
        .filtros-grid { grid-template-columns: 1fr 1fr 1fr; }
        .charts-grid { grid-template-columns: 1fr; }
    }
    @media (max-width: 900px) {
        .filtros-grid { grid-template-columns: 1fr 1fr; }
        .form-group-actions { grid-column: 1 / -1; }
    }
    @media (max-width: 700px) {
        .actions-header-group {
            width: 100%;
            justify-content: stretch;
        }
        .actions-header-group .btn {
            flex: 1 1 140px;
            justify-content: center;
        }
        .filtros-card {
            padding: 14px;
        }
        .filtros-grid { grid-template-columns: 1fr; }
        .filtros-actions .btn {
            flex: 1;
            justify-content: center;
        }
        .chart-container-tall {
            height: 240px;
        }
    }
</style>
